  customerUserRoleId     String                 @map("customer_user_role_id") @db.Uuid
  photographerUserRoleId String                 @map("photographer_user_role_id") @db.Uuid
  serviceId              String                 @map("service_id") @db.Uuid
  creatorUserId          String                 @map("creator_user_id") @db.Uuid
