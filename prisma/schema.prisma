generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum IdentityVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum RoleCode {
  CUSTOMER
  PHOTOGRAPHER
  ADMIN
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  HIDDEN
  SUSPENDED
}

enum PhotographerAvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ServiceMode {
  OFFERED
  WANTED
}

enum SwipeDirection {
  LEFT
  RIGHT
  ACCEPT
  REJECT
}

enum SwipeSource {
  DISCOVERY
  NEARBY
  PROFILE
}

enum MatchStatus {
  ACTIVE
  ENDED
  BLOCKED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  BLOCKED
}

enum MessageType {
  TEXT
  SYSTEM
  IMAGE
  FILE
}

enum MessageStatus {
  SENT
  DELIVERED
  FAILED
}

enum ShootRequestStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum BookingStatus {
  DRAFT
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  IN_PROGRESS
  COMPLETED
  DISPUTED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum NotificationType {
  MATCH_CREATED
  MESSAGE_RECEIVED
  BOOKING_CREATED
  BOOKING_STATUS_CHANGED
  REPORT_RESOLVED
  ACCOUNT_PENALTY_CREATED
  SYSTEM
}

enum ReportReasonCode {
  SPAM
  HARASSMENT
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  SCAM
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum PenaltyType {
  WARNING
  TEMPORARY_SUSPENSION
  PERMANENT_BAN
  FEATURE_RESTRICTION
}

enum PenaltyStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  COMMUNITY_GUIDELINES
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum LanguageCode {
  VI
  EN
}

enum MapType {
  STANDARD
  SATELLITE
  HYBRID
}

enum UploadPurpose {
  AVATAR
  PORTFOLIO
  CHAT_IMAGE
  CHAT_FILE
  REPORT_EVIDENCE
}

enum UploadIntentStatus {
  PENDING
  COMPLETED
  EXPIRED
  REJECTED
}

enum UploadAssetStatus {
  USABLE
  QUARANTINED
  REMOVED
}

enum DeviceProvider {
  EXPO
  FCM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  email                      String?                    @unique @db.VarChar(320)
  phone                      String?                    @unique @db.VarChar(32)
  accountStatus              AccountStatus              @default(PENDING_VERIFICATION) @map("account_status")
  identityVerificationStatus IdentityVerificationStatus @default(NOT_SUBMITTED) @map("identity_verification_status")
  emailVerified              Boolean                    @default(false) @map("email_verified")
  phoneVerified              Boolean                    @default(false) @map("phone_verified")
  currentRoleId              String?                    @map("current_role_id") @db.Uuid
  onboardingCompletedAt      DateTime?                  @map("onboarding_completed_at") @db.Timestamptz(3)
  lastLoginAt                DateTime?                  @map("last_login_at") @db.Timestamptz(3)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?                  @map("deleted_at") @db.Timestamptz(3)

  currentRole             UserRole?                 @relation("CurrentRole", fields: [currentRoleId], references: [id], onDelete: SetNull)
  authIdentities          AuthIdentity[]
  authSessions            AuthSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  profile                 UserProfile?
  roles                   UserRole[]                @relation("UserOwnedRoles")
  settings                UserSettings?
  locations               UserLocation[]
  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]
  messageReceipts         MessageReceipt[]
  blocksCreated           UserBlock[]               @relation("Blocker")
  blocksReceived          UserBlock[]               @relation("Blocked")
  bookingChanges          BookingStatusHistory[]
  createdBookings         Booking[]                 @relation("BookingCreator")
  reviewsWritten          Review[]                  @relation("ReviewWriter")
  reviewsReceived         Review[]                  @relation("ReviewTarget")
  reviewsModerated        Review[]                  @relation("ReviewModerator")
  notificationsReceived   Notification[]            @relation("NotificationRecipient")
  notificationsTriggered  Notification[]            @relation("NotificationActor")
  identityVerifications   IdentityVerification[]
  reportsCreated          UserReport[]              @relation("ReportReporter")
  reportsReceived         UserReport[]              @relation("ReportTarget")
  reportsResolved         UserReport[]              @relation("ReportResolver")
  penaltiesReceived       AccountPenalty[]          @relation("PenaltyTarget")
  penaltiesImposed        AccountPenalty[]          @relation("PenaltyImposer")
  penaltiesRevoked        AccountPenalty[]          @relation("PenaltyRevoker")
  consents                UserConsent[]
  devices                 DeviceRegistration[]
  uploadIntents           UploadIntent[]
  uploadAssets            UploadAsset[]
  endedMatches            Match[]                   @relation("MatchEnder")

  @@index([accountStatus, createdAt])
  @@index([identityVerificationStatus, createdAt])
  @@map("users")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String?      @map("provider_subject") @db.VarChar(255)
  email           String?      @db.VarChar(320)
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([provider, email])
  @@index([userId])
  @@map("auth_identities")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamilyId])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  attemptCount Int       @default(0) @map("attempt_count")
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  attemptCount Int       @default(0) @map("attempt_count")
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(3)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("password_reset_tokens")
}

model UserProfile {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @unique @map("user_id") @db.Uuid
  cityId        String?       @map("city_id") @db.Uuid
  avatarAssetId String?       @map("avatar_asset_id") @db.Uuid
  displayName   String?       @map("display_name") @db.VarChar(120)
  dateOfBirth   DateTime?     @map("date_of_birth") @db.Date
  bio           String?       @db.VarChar(1000)
  status        ProfileStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  avatarAsset   UploadAsset?  @relation("ProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)

  @@index([cityId, status])
  @@map("user_profiles")
}

model Role {
  id            String              @id @default(uuid()) @db.Uuid
  code          RoleCode            @unique
  name          String              @db.VarChar(80)
  description   String?             @db.VarChar(500)
  status        RoleStatus          @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRoles     UserRole[]
  allowedFields RoleActivityField[]

  @@map("roles")
}

model UserRole {
  id                      String               @id @default(uuid()) @db.Uuid
  userId                  String               @map("user_id") @db.Uuid
  roleId                  String               @map("role_id") @db.Uuid
  status                  RoleStatus           @default(ACTIVE)
  isInitialAdditionalRole Boolean              @default(false) @map("is_initial_additional_role")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                    User                 @relation("UserOwnedRoles", fields: [userId], references: [id], onDelete: Cascade)
  role                    Role                 @relation(fields: [roleId], references: [id])
  currentForUsers         User[]               @relation("CurrentRole")
  photographerProfile     PhotographerProfile?
  selectedFields          UserRoleField[]
  selectedServices        UserRoleService[]
  portfolioItems          PortfolioItem[]
  locationsPresence       DiscoveryPresence?
  discoveryFilters        DiscoveryFilter[]    @relation("DiscoveryOwnerRole")
  discoveryTargetFilters  DiscoveryFilter[]    @relation("DiscoveryTargetRole")
  swipesPerformed         Swipe[]              @relation("SwipeActor")
  swipesReceived          Swipe[]              @relation("SwipeTarget")
  matchesAsA              Match[]              @relation("MatchSideA")
  matchesAsB              Match[]              @relation("MatchSideB")
  customerBookings        Booking[]            @relation("BookingCustomer")
  photographerBookings    Booking[]            @relation("BookingPhotographer")
  shootRequests           ShootRequest[]

  @@unique([userId, roleId])
  @@index([roleId, status])
  @@map("user_roles")
}

model PhotographerProfile {
  id                 String                         @id @default(uuid()) @db.Uuid
  userRoleId         String                         @unique @map("user_role_id") @db.Uuid
  availabilityStatus PhotographerAvailabilityStatus @default(UNAVAILABLE) @map("availability_status")
  headline           String?                        @db.VarChar(160)
  yearsExperience    Int?                           @map("years_experience")
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRole           UserRole                       @relation(fields: [userRoleId], references: [id], onDelete: Cascade)

  @@index([availabilityStatus])
  @@map("photographer_profiles")
}

model City {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique @db.VarChar(40)
  name          String         @db.VarChar(120)
  status        CatalogStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles      UserProfile[]
  shootRequests ShootRequest[]

  @@map("cities")
}

model ActivityField {
  id             String              @id @default(uuid()) @db.Uuid
  code           String              @unique @db.VarChar(60)
  name           String              @db.VarChar(120)
  description    String?             @db.VarChar(500)
  status         CatalogStatus       @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  roleMappings   RoleActivityField[]
  services       Service[]
  userSelections UserRoleField[]

  @@index([status, createdAt])
  @@map("activity_fields")
}

model RoleActivityField {
  roleId          String        @map("role_id") @db.Uuid
  activityFieldId String        @map("activity_field_id") @db.Uuid
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  activityField   ActivityField @relation(fields: [activityFieldId], references: [id], onDelete: Cascade)

  @@id([roleId, activityFieldId])
  @@map("role_activity_fields")
}

model Service {
  id               String                   @id @default(uuid()) @db.Uuid
  activityFieldId  String                   @map("activity_field_id") @db.Uuid
  code             String                   @unique @db.VarChar(80)
  name             String                   @db.VarChar(120)
  description      String?                  @db.VarChar(500)
  status           CatalogStatus            @default(ACTIVE)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  activityField    ActivityField            @relation(fields: [activityFieldId], references: [id])
  userSelections   UserRoleService[]
  portfolioItems   PortfolioItem[]
  filterSelections DiscoveryFilterService[]
  shootRequests    ShootRequest[]
  bookings         Booking[]

  @@index([activityFieldId, status])
  @@map("services")
}

model UserRoleField {
  userRoleId      String        @map("user_role_id") @db.Uuid
  activityFieldId String        @map("activity_field_id") @db.Uuid
  selectedAt      DateTime      @default(now()) @map("selected_at") @db.Timestamptz(3)
  userRole        UserRole      @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  activityField   ActivityField @relation(fields: [activityFieldId], references: [id])

  @@id([userRoleId, activityFieldId])
  @@map("user_role_fields")
}

model UserRoleService {
  id          String      @id @default(uuid()) @db.Uuid
  userRoleId  String      @map("user_role_id") @db.Uuid
  serviceId   String      @map("service_id") @db.Uuid
  serviceMode ServiceMode @map("service_mode")
  minPrice    Decimal?    @map("min_price") @db.Decimal(14, 2)
  maxPrice    Decimal?    @map("max_price") @db.Decimal(14, 2)
  currency    String      @default("VND") @db.VarChar(3)
  priceUnit   String?     @map("price_unit") @db.VarChar(40)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRole    UserRole    @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@unique([userRoleId, serviceId, serviceMode])
  @@index([serviceId, serviceMode, isActive])
  @@map("user_role_services")
}

model PortfolioItem {
  id          String      @id @default(uuid()) @db.Uuid
  userRoleId  String      @map("user_role_id") @db.Uuid
  serviceId   String?     @map("service_id") @db.Uuid
  assetId     String      @unique @map("asset_id") @db.Uuid
  title       String?     @db.VarChar(160)
  description String?     @db.VarChar(1000)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(3)
  userRole    UserRole    @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  asset       UploadAsset @relation(fields: [assetId], references: [id])

  @@index([userRoleId, deletedAt, sortOrder])
  @@map("portfolio_items")
}

model UserSettings {
  userId                          String          @id @map("user_id") @db.Uuid
  language                        LanguageCode    @default(VI)
  theme                           ThemePreference @default(SYSTEM)
  mapType                         MapType         @default(STANDARD) @map("map_type")
  matchNotificationsEnabled       Boolean         @default(true) @map("match_notifications_enabled")
  bookingNotificationsEnabled     Boolean         @default(true) @map("booking_notifications_enabled")
  readReceiptsEnabled             Boolean         @default(true) @map("read_receipts_enabled")
  profileVisibilityEnabled        Boolean         @default(false) @map("profile_visibility_enabled")
  locationVisibilityDurationHours Int             @default(24) @map("location_visibility_duration_hours")
  createdAt                       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserLocation {
  id             String                                @id @default(uuid()) @db.Uuid
  userId         String                                @map("user_id") @db.Uuid
  exactPoint     Unsupported("geography(Point, 4326)") @map("exact_point")
  accuracyMeters Float?                                @map("accuracy_meters")
  isCurrent      Boolean                               @default(true) @map("is_current")
  capturedAt     DateTime                              @map("captured_at") @db.Timestamptz(3)
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?                             @map("deleted_at") @db.Timestamptz(3)
  user           User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
  @@map("user_locations")
}

model DiscoveryPresence {
  id                  String                                @id @default(uuid()) @db.Uuid
  userRoleId          String                                @unique @map("user_role_id") @db.Uuid
  publicPoint         Unsupported("geography(Point, 4326)") @map("public_point")
  publicRadiusMeters  Int                                   @map("public_radius_meters")
  locationNoiseMeters Int                                   @map("location_noise_meters")
  isVisible           Boolean                               @default(false) @map("is_visible")
  visibleUntil        DateTime?                             @map("visible_until") @db.Timestamptz(3)
  createdAt           DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRole            UserRole                              @relation(fields: [userRoleId], references: [id], onDelete: Cascade)

  @@index([isVisible, visibleUntil])
  @@map("discovery_presence")
}

model DiscoveryFilter {
  id              String                   @id @default(uuid()) @db.Uuid
  ownerUserRoleId String                   @map("owner_user_role_id") @db.Uuid
  targetRoleId    String                   @map("target_role_id") @db.Uuid
  radiusKm        Int                      @default(20) @map("radius_km")
  minPrice        Decimal?                 @map("min_price") @db.Decimal(14, 2)
  maxPrice        Decimal?                 @map("max_price") @db.Decimal(14, 2)
  availableOnly   Boolean                  @default(false) @map("available_only")
  verifiedOnly    Boolean                  @default(false) @map("verified_only")
  isDefault       Boolean                  @default(false) @map("is_default")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  ownerRole       UserRole                 @relation("DiscoveryOwnerRole", fields: [ownerUserRoleId], references: [id], onDelete: Cascade)
  targetRole      UserRole                 @relation("DiscoveryTargetRole", fields: [targetRoleId], references: [id], onDelete: Cascade)
  services        DiscoveryFilterService[]
  swipes          Swipe[]

  @@index([ownerUserRoleId, targetRoleId, isDefault])
  @@map("discovery_filters")
}

model DiscoveryFilterService {
  discoveryFilterId String          @map("discovery_filter_id") @db.Uuid
  serviceId         String          @map("service_id") @db.Uuid
  discoveryFilter   DiscoveryFilter @relation(fields: [discoveryFilterId], references: [id], onDelete: Cascade)
  service           Service         @relation(fields: [serviceId], references: [id])

  @@id([discoveryFilterId, serviceId])
  @@map("discovery_filter_services")
}

model Swipe {
  id                String           @id @default(uuid()) @db.Uuid
  actorUserRoleId   String           @map("actor_user_role_id") @db.Uuid
  targetUserRoleId  String           @map("target_user_role_id") @db.Uuid
  discoveryFilterId String?          @map("discovery_filter_id") @db.Uuid
  direction         SwipeDirection
  source            SwipeSource
  effectiveUntil    DateTime?        @map("effective_until") @db.Timestamptz(3)
  resolvedAt        DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  actorRole         UserRole         @relation("SwipeActor", fields: [actorUserRoleId], references: [id], onDelete: Cascade)
  targetRole        UserRole         @relation("SwipeTarget", fields: [targetUserRoleId], references: [id], onDelete: Cascade)
  discoveryFilter   DiscoveryFilter? @relation(fields: [discoveryFilterId], references: [id], onDelete: SetNull)

  @@index([actorUserRoleId, targetUserRoleId, createdAt])
  @@index([targetUserRoleId, direction, resolvedAt, createdAt])
  @@map("swipes")
}

model Match {
  id            String         @id @default(uuid()) @db.Uuid
  userRoleAId   String         @map("user_role_a_id") @db.Uuid
  userRoleBId   String         @map("user_role_b_id") @db.Uuid
  endedByUserId String?        @map("ended_by_user_id") @db.Uuid
  pairKey       String         @map("pair_key") @db.VarChar(80)
  activePairKey String?        @unique @map("active_pair_key") @db.VarChar(80)
  status        MatchStatus    @default(ACTIVE)
  endReason     String?        @map("end_reason") @db.VarChar(500)
  matchedAt     DateTime       @default(now()) @map("matched_at") @db.Timestamptz(3)
  endedAt       DateTime?      @map("ended_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  userRoleA     UserRole       @relation("MatchSideA", fields: [userRoleAId], references: [id])
  userRoleB     UserRole       @relation("MatchSideB", fields: [userRoleBId], references: [id])
  endedByUser   User?          @relation("MatchEnder", fields: [endedByUserId], references: [id], onDelete: SetNull)
  conversation  Conversation?
  bookings      Booking[]
  notifications Notification[]
  reports       UserReport[]

