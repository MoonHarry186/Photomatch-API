{
  "name": "photomatch-api",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=unit",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "test:e2e": "jest --runInBand --testPathPattern=e2e",
    "test:contract": "jest --runInBand --testPathPattern=contract",
    "test:cov": "jest --runInBand --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "seed": "ts-node -r dotenv/config prisma/seed.ts",
    "seed:admin-demo": "ts-node -r dotenv/config scripts/seed-admin-demo.ts",
    "create-admin": "ts-node -r dotenv/config scripts/create-admin.ts",
    "openapi:export": "ts-node scripts/export-openapi.ts",
    "migration:deploy": "node scripts/deploy-migrations.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/s3-request-presigner": "3.1090.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@prisma/client": "5.12.1",
    "@sentry/node": "7.109.0",
    "argon2": "0.45.0",
    "bullmq": "5.80.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "17.4.1",
    "ioredis": "5.3.2",
    "jose": "4.15.5",
    "nodemailer": "9.0.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino": "8.19.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.28",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "22.15.3",
    "@types/nodemailer": "6.4.14",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.5.0",
    "@typescript-eslint/parser": "7.5.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "prisma": "5.12.1",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.4.5"
  }
}
